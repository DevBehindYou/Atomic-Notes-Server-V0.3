# Names and safe defaults only. Owner supplies new credentials directly in the
# NEW atomic-notes-app-server-staging Vercel project's Production scope.
# The application is staging even though Vercel calls its stable target Production.
# This file is never auto-loaded. Do not copy existing production values.
MONGODB_URI=
MONGODB_DB_NAME=atomic_notes_app_staging
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://atomic-notes-app-server-staging.vercel.app/api/auth/callback
TOKEN_ENCRYPTION_KEY=
ADMIN_API_KEY=
# Empty is appropriate for native-only testing; exact staging HTTPS origins only.
ALLOWED_ORIGIN=
# Optional. Leave unset for baseline runtime policy:
# ATOMIC_LOGOUT_SYNC_ENABLED=false
# COIN_EXPIRY_ACTIVATED_AT=
