{
  "name": "atomic-notes-server",
  "version": "0.2.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/dev.ts",
    "build": "tsc",
    "db:indexes": "node --env-file-if-exists=.env --import tsx src/scripts/ensureIndexes.ts",
    "db:retain-sync-history": "node --env-file-if-exists=.env --import tsx src/scripts/retainSyncHistory.ts",
    "db:inspect-ledger-history": "node --env-file-if-exists=.env --import tsx src/scripts/inspectLedgerHistory.ts",
    "db:inspect": "node --env-file-if-exists=.env --import tsx src/scripts/inspectUser.ts",
    "notifications:welcome": "node --env-file-if-exists=.env --import tsx src/scripts/publishWelcome.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "node --import tsx --test tests/unit.test.ts tests/clientFixture.unit.test.ts",
    "test:client-fixture": "node --import tsx --test tests/clientFixture.smoke.test.ts tests/clientFixture.failures.test.ts tests/clientFixture.conflicts.test.ts tests/clientFixture.pullIntegrity.test.ts tests/clientFixture.wipe.test.ts tests/clientFixture.batches.test.ts tests/clientFixture.sessions.test.ts tests/clientFixture.cappedRefund.test.ts tests/clientFixture.encrypted.test.ts tests/clientFixture.crossStore.test.ts",
    "fixture:client": "node --import tsx tests/clientFixture.ts",
    "test:integration": "node --import tsx --test tests/integration.test.ts",
    "benchmark:admin-pages": "node --import tsx tests/adminPages.benchmark.ts"
  },
  "dependencies": {
    "googleapis": "150.0.1",
    "hono": "^4.6.0",
    "mongodb": "^6.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.0",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": "22.x"
  }
}
